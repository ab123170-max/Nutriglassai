# Configure these as server-side environment variables in your hosting provider.
# Never put a real API key in public/ or commit it to GitHub.
GEMINI_API_KEY=replace_with_your_server_side_key
GEMINI_MODEL=gemini-3.8-flash
PORT=3000
# Supabase project settings (public anon/publishable key only)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key
